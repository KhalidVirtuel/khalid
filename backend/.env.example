# Server Configuration
PORT=8787
USE_WS=true
NODE_ENV=development

# JWT Secret - Générer une clé aléatoire sécurisée
# Exemple: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_random_secret

# MySQL Configuration (Docker)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=jure
MYSQL_PASSWORD=jur3pass
MYSQL_DATABASE=jure_ai

# Database URL for Prisma
DATABASE_URL="mysql://jure:jur3pass@mysql:3306/jure_ai"

# Groq API Configuration
# Obtenir une clé sur: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Configuration
# Obtenir une clé sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Speech Configuration
STT_LANGUAGE=fr
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Qdrant Vector Database Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=company_knowledge_fr
