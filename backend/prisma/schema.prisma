// Prisma Schema adapté au frontend Jure-AX

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modèle Utilisateur (Profile)
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  lawFirm        String?  @map("law_firm")
  legalSpecialty String?  @map("legal_specialty")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  folders            Folder[]
  conversations      Conversation[]
  messages           Message[]
  knowledgeDocuments KnowledgeDocument[]

  @@index([email])
  @@map("users")
}

// Modèle Dossier (Folder)
model Folder {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?  @db.Text
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  timeline     TimelineEntry[]
  documents    GeneratedDocument[]
  deadlines    Deadline[]
  conversations Conversation[]

  @@index([userId])
  @@map("folders")
}

// Modèle Pièce Jointe (Attachment)
model Attachment {
  id         String         @id @default(uuid())
  folderId   String         @map("folder_id")
  name       String
  type       AttachmentType
  url        String
  size       Int
  uploadedAt DateTime       @default(now()) @map("uploaded_at")

  // Relations
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("attachments")
}

enum AttachmentType {
  EVIDENCE
  CONTRACT
  DOCUMENT
  OTHER
}

// Modèle Entrée de Chronologie (Timeline)
model TimelineEntry {
  id          String            @id @default(uuid())
  folderId    String            @map("folder_id")
  title       String
  description String            @db.Text
  type        TimelineEntryType
  date        DateTime
  createdAt   DateTime          @default(now()) @map("created_at")

  // Relations
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("timeline_entries")
}

enum TimelineEntryType {
  FACT
  PROCEDURE
  HEARING
  DEADLINE
  EVENT
}

// Modèle Document Généré
model GeneratedDocument {
  id           String               @id @default(uuid())
  folderId     String               @map("folder_id")
  title        String
  type         GeneratedDocumentType
  content      String               @db.LongText
  createdAt    DateTime             @default(now()) @map("created_at")
  lastModified DateTime             @updatedAt @map("last_modified")

  // Relations
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("generated_documents")
}

enum GeneratedDocumentType {
  CONTRACT
  CONCLUSION
  NOTE
  LETTER
  REPORT
}

// Modèle Échéance (Deadline)
model Deadline {
  id          String         @id @default(uuid())
  folderId    String         @map("folder_id")
  title       String
  description String         @db.Text
  dueDate     DateTime       @map("due_date")
  priority    Priority
  status      DeadlineStatus @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")

  // Relations
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([status])
  @@map("deadlines")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeadlineStatus {
  PENDING
  COMPLETED
  OVERDUE
}

// Modèle Conversation (Chat)
model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  folderId  String?  @map("folder_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([folderId])
  @@map("conversations")
}

// Modèle Message
model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  userId         String      @map("user_id")
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
}

// Modèle Base de Connaissance (RAG)
model KnowledgeDocument {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  description  String   @db.Text
  category     String   // general, code_penal, code_civil, etc.
  filename     String
  originalName String   @map("original_name")
  filepath     String
  mimetype     String
  size         Int
  textContent  String   @db.LongText @map("text_content")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("knowledge_documents")
}
